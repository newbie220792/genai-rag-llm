  <diagram id="t3TKT7hfVJcvyuLORcM9" name="RAG">
    <mxGraphModel dx="411" dy="238" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ldf7czHNChvGVOxI9Kgl-1" value="&lt;h1&gt;RAG with spring boot&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ldf7czHNChvGVOxI9Kgl-2" value="&lt;h1&gt;Khái niệm:&amp;nbsp;&lt;/h1&gt;- Retrieval-Augmented Generation - Tạo sinh tăng cường bằng truy xuất&lt;div&gt;- Đây là kỹ thuật hữu dụng giúp LLM có thể kết nối với acknowledge bên ngoài (file pdf, excel, DB...) đẻ tạo câu trả lời cho user&amp;nbsp; chính xác&lt;/div&gt;&lt;div&gt;- user ask (query) -&amp;gt; query acknowledge -&amp;gt; get top information -&amp;gt; build prompt -&amp;gt; LLM generate answer&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ldf7czHNChvGVOxI9Kgl-3" value="&lt;h1&gt;Architecture&lt;/h1&gt;&lt;div&gt;-&amp;nbsp;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1100" height="120" as="geometry" />
        </mxCell>
