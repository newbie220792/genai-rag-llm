  <diagram id="JHn5LR9zkF_P1fh6-LIq" name="Token">
    <mxGraphModel dx="719" dy="405" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ROBOkvAM3LABQl1HG5mk-1" parent="1" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=31;" value="Token" vertex="1">
          <mxGeometry height="70" width="240" x="480" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ROBOkvAM3LABQl1HG5mk-2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;What is it?&lt;/h1&gt;- là đơn vị dữ liệu cơ bản được xử lý bởi các thuật toán&lt;br&gt;- việc token hóa ảnh hưởng nhiều&amp;nbsp; tới khả năng học, xử lý dữ liệu của model&lt;div&gt;- Cần lựa chọn kỹ thuật toán tokenize&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="1130" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ROBOkvAM3LABQl1HG5mk-3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;Tokenize&lt;/h1&gt;&lt;div&gt;- Word-based tokenizers&lt;/div&gt;&lt;div&gt;- Character-based tokenizers&lt;/div&gt;&lt;div&gt;- Subword-based tokenizers&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="580" x="20" y="220" as="geometry" />
