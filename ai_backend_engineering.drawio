  <diagram id="JHn5LR9zkF_P1fh6-LIq" name="Token">
    <mxGraphModel dx="1182" dy="683" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ROBOkvAM3LABQl1HG5mk-1" value="Token" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=31;" parent="1" vertex="1">
          <mxGeometry x="480" y="50" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ROBOkvAM3LABQl1HG5mk-2" value="&lt;h1&gt;What is it?&lt;/h1&gt;- là đơn vị dữ liệu cơ bản được xử lý bởi các thuật toán&lt;br&gt;- việc token hóa ảnh hưởng nhiều&amp;nbsp; tới khả năng học, xử lý dữ liệu của model&lt;div&gt;- Cần lựa chọn kỹ thuật toán tokenize&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="120" width="1130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ROBOkvAM3LABQl1HG5mk-3" value="&lt;h1&gt;Tokenize&lt;/h1&gt;&lt;div&gt;- Word-based tokenizers&lt;/div&gt;&lt;div&gt;- Character-based tokenizers&lt;/div&gt;&lt;div&gt;- Subword-based tokenizers&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="220" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fyvZpXNvvik-ce2JKKUr-1" value="&lt;p style=&quot;line-height: 100%;&quot;&gt;&lt;/p&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 110%;&quot;&gt;Ứng dụng trong java&lt;/h1&gt;&lt;div style=&quot;line-height: 110%;&quot;&gt;- Spring AI&lt;/div&gt;&lt;div style=&quot;line-height: 110%;&quot;&gt;- JTokkit&lt;/div&gt;&lt;div style=&quot;line-height: 110%;&quot;&gt;&amp;nbsp;Hai lib của java hỗ trợ chunking text -&amp;gt; token&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="320" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bVh2kuyGzXaLFcFV13Gs-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Token Limit&lt;/h1&gt;-&amp;nbsp; the maximum amount of text (words, characters, or subwords) a model can process or generate in a single interaction, encompassing both input prompt and output response&lt;br&gt;-&amp;nbsp;These limits, or context windows, determine how much information the AI can &quot;remember&quot; at once, with common limits ranging from 4,000 to over 1 million tokens depending on the mode&lt;br&gt;-&amp;nbsp;&lt;strong data-end=&quot;735&quot; data-start=&quot;720&quot;&gt;Token limit&lt;/strong&gt; = giới hạn tối đa context window của model." style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="430" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bVh2kuyGzXaLFcFV13Gs-4" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;API Cost&lt;/h1&gt;- Chi phí API (API cost) của LLM như các model từ &lt;strong data-end=&quot;89&quot; data-start=&quot;48&quot;&gt;OpenAI&lt;/strong&gt; được tính &lt;strong data-end=&quot;126&quot; data-start=&quot;100&quot;&gt;theo số token bạn dùng&lt;/strong&gt;, không phải theo số request.&lt;div&gt;-&amp;nbsp;Cost = (Input tokens × giá input) + (Output tokens × giá output)&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="560" width="920" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bVh2kuyGzXaLFcFV13Gs-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Context Window&lt;/h1&gt;&lt;div&gt;- Tổng&amp;nbsp; số token mà model có thể dùng để tạo ra token kế tiếp, bao gồm original token, conversion, prompt....&lt;/div&gt;&lt;div&gt;-&amp;nbsp; Cỏ thể nói đây là bộ nhớ tạm của model trong session, mà model dùng để tạo token kế tiếp&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="650" width="900" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cX_MwuL7rfwVraIe3_tk" name="Models">
    <mxGraphModel dx="978" dy="566" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="QqDe8EgD1-jVsejgj4FI-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Model&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=center;" parent="1" vertex="1">
          <mxGeometry x="470" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="QqDe8EgD1-jVsejgj4FI-3" value="Khái niệm:&amp;nbsp;&lt;strong data-start=&quot;10&quot; data-end=&quot;29&quot;&gt;model (mô hình)&lt;/strong&gt; là &lt;strong data-start=&quot;33&quot; data-end=&quot;124&quot;&gt;chương trình/toán học đã được huấn luyện để đưa ra dự đoán hoặc sinh kết quả từ dữ liệu&lt;/strong&gt;." style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="100" width="940" height="30" as="geometry" />
        </mxCell>
        <mxCell id="QqDe8EgD1-jVsejgj4FI-4" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 100%;&quot;&gt;Phân loại:&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 100%;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px; line-height: 100%;&quot;&gt;Frontier Model&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 100%;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px; line-height: 100%;&quot;&gt;Large Language Model&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 100%;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px; line-height: 100%;&quot;&gt;Data Model&lt;/font&gt;&lt;/span&gt;&amp;nbsp;&lt;/h1&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="1080" height="150" as="geometry" />
        </mxCell>
        <mxCell id="deCCANOWPb0SjDphnAeg-1" value="&lt;h1&gt;Parameter&lt;/h1&gt;&lt;div&gt;&lt;strong data-end=&quot;151&quot; data-start=&quot;138&quot;&gt;Parameter&lt;/strong&gt; = &lt;strong data-end=&quot;196&quot; data-start=&quot;154&quot;&gt;các trọng số (weights) bên trong model&lt;/strong&gt; mà model học được từ dữ liệu&lt;/div&gt;&lt;p data-end=&quot;1087&quot; data-start=&quot;1067&quot;&gt;Parameter nhận được khi training model và không thay đổi&amp;nbsp;&lt;/p&gt;&lt;p data-end=&quot;1087&quot; data-start=&quot;1067&quot;&gt;Parameter = toàn bộ:&lt;/p&gt;&lt;ul data-end=&quot;1143&quot; data-start=&quot;1089&quot;&gt;&lt;li data-end=&quot;1104&quot; data-start=&quot;1089&quot; data-section-id=&quot;49pdub&quot;&gt;&lt;p data-end=&quot;1104&quot; data-start=&quot;1091&quot;&gt;weight matrix&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1123&quot; data-start=&quot;1105&quot; data-section-id=&quot;1croowe&quot;&gt;&lt;p data-end=&quot;1123&quot; data-start=&quot;1107&quot;&gt;attention layers&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1143&quot; data-start=&quot;1124&quot; data-section-id=&quot;hifis4&quot;&gt;&lt;p data-end=&quot;1143&quot; data-start=&quot;1126&quot;&gt;embedding weights&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="710" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
